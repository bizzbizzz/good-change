<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.best.backspringboot.mapper.CardMapper">

    <resultMap id="cardResultMap" type="org.best.backspringboot.entity.Card">
        <id  property="cardId"     column="card_id"/>
        <result property="memberId"   column="member_id"/>
        <result property="cardNumber" column="card_number"/>
        <result property="cardAlias"  column="card_alias"/>
        <result property="isPrimary"  column="is_primary"/>
        <result property="status"     column="status"/>
        <result property="createdAt"  column="created_at"/>
        <result property="updatedAt"  column="updated_at"/>
    </resultMap>

    <select id="findByCardNumber" resultMap="cardResultMap">
        SELECT * FROM card WHERE card_number = #{cardNumber}
    </select>

    <select id="findById" resultMap="cardResultMap">
        SELECT * FROM card WHERE card_id = #{cardId}
    </select>

</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.best.backspringboot.mapper.MemberMapper">
    <resultMap id="memberResultMap" type="org.best.backspringboot.entity.Member">
        <id property="memberId"   column="member_id"/>
        <result property="loginId"    column="login_id"/>
        <result property="roleId"     column="role_id"/>
        <result property="password"   column="password"/>
        <result property="name"       column="name"/>
        <result property="birthDate"  column="birth_date"/>
        <result property="gender"     column="gender"/>
        <result property="phone"      column="phone"/>
        <result property="address"    column="address"/>
        <result property="email"      column="email"/>
        <result property="referrerId" column="referrer_id"/>
        <result property="point"      column="point"/>
        <result property="status"     column="status"/>
        <result property="createdAt"  column="created_at"/>
        <result property="updatedAt"  column="updated_at"/>
        <result property="applyDate"   column="apply_date"/>
        <result property="approveDate" column="approve_date"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="memberId">
        INSERT INTO member (
            role_id, login_id, password, name, birth_date,
            gender, phone, address, email, point, status,
            referrer_id, apply_date, approve_date, created_at
        ) VALUES (
                     #{roleId}, #{loginId}, #{password}, #{name}, #{birthDate},
                     #{gender}, #{phone}, #{address}, #{email}, 0, 'ACTIVE',
                     #{referrerId}, #{applyDate}, #{approveDate}, NOW()
                 )
    </insert>

    <select id="findById" resultMap="memberResultMap">
        SELECT * FROM member
        WHERE member_id = #{memberId}
    </select>

    <select id="findAll" resultMap="memberResultMap">
        SELECT * FROM member
        WHERE status = 'ACTIVE'
          AND role_id != 1
        ORDER BY created_at DESC
            LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM member
        WHERE status = 'ACTIVE'
          AND role_id != 1
    </select>

    <select id="findLeaveList" resultMap="memberResultMap">
        SELECT * FROM member
        WHERE status = 'DISABLED'
        ORDER BY updated_at DESC
            LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countLeave" resultType="long">
        SELECT COUNT(*) FROM member
        WHERE status = 'DISABLED'
    </select>

    <update id="updatePoint">
        UPDATE member SET point = #{point} WHERE member_id = #{memberId}
    </update>

    <select id="findByLoginId" resultMap="memberResultMap">
        SELECT * FROM member
        WHERE login_id = #{loginId}
    </select>

    <update id="update">
        UPDATE member
        <set>
            <if test="dto.name    != null">name    = #{dto.name},</if>
            <if test="dto.phone   != null">phone   = #{dto.phone},</if>
            <if test="dto.address != null">address = #{dto.address},</if>
            <if test="dto.email   != null">email   = #{dto.email},</if>
        </set>
        WHERE login_id = #{loginId}
    </update>

    <update id="delete">
        UPDATE member
        SET status = 'DISABLED'
        WHERE login_id = #{loginId}
    </update>

</mapper>
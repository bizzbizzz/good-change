<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.best.backspringboot.member.mapper.MemberWithdrawLogMapper">

    <resultMap id="withdrawLogResultMap" type="org.best.backspringboot.member.entity.MemberWithdrawLog">
        <id     property="logId"     column="log_id"/>
        <result property="memberId"  column="member_id"/>
        <result property="loginId"   column="login_id"/>
        <result property="name"      column="name"/>
        <result property="reason"    column="reason"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="logId">
        INSERT INTO member_withdraw_log (member_id, login_id, name, reason, created_at)
        VALUES (#{memberId}, #{loginId}, #{name}, #{reason}, NOW())
    </insert>

</mapper>
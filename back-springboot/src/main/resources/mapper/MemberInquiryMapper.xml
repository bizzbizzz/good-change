<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.best.backspringboot.mapper.MemberInquiryMapper">

    <resultMap id="memberInquiryResultMap" type="org.best.backspringboot.entity.MemberInquiry">
        <id property="memberInquiryId" column="id"/>
        <result property="memberInquiryName" column="name"/>
        <result property="memberInquiryPhone" column="phone"/>
        <result property="memberInquiryTitle" column="title"/>
        <result property="memberInquiryContent" column="content"/>
        <result property="memberInquiryStatus" column="status"/>
        <result property="memberInquiryType" column="type"/>
        <result property="createDate" column="created_at"/>
        <result property="answeredDate" column="answered_at"/>
    </resultMap>

    <insert id="insertInquiry" parameterType="org.best.backspringboot.dto.memberInquiry.MemberInquiryRequestDto">
        INSERT INTO member_inquiry (name, phone, title, content, type)
        VALUES (#{memberInquiryName},
                #{memberInquiryPhone},
                #{memberInquiryTitle},
                #{memberInquiryContent},
                #{memberInquiryType})
    </insert>

    <select id="selectAllInquiry" resultMap="memberInquiryResultMap">
        SELECT * FROM member_inquiry
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
            <if test="title != null and title != ''">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
        </where>
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM member_inquiry
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
            <if test="title != null and title != ''">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
        </where>
    </select>

    <select id="selectInquiryById" parameterType="Long" resultMap="memberInquiryResultMap">
        SELECT *
        FROM member_inquiry
        WHERE id = #{id}
    </select>

    <update id="updateStatus" parameterType="Long">
        UPDATE member_inquiry
        SET status      = 'DONE',
            answered_at = NOW()
        WHERE id = #{id}
    </update>

    <update id="updateStatusByIds">
        UPDATE member_inquiry
        SET status = 'DONE', answered_at = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="updateStatusToWaitByIds">
        UPDATE member_inquiry
        SET status = 'WAIT', answered_at = NULL
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <delete id="deleteByIds">
        DELETE FROM member_inquiry
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>